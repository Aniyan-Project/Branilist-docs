{
  "name": "branilist-public-api-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Documentação da API pública REST do Branilist",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/validate-docs.mjs && node --test examples/examples.test.mjs scripts/site.test.mjs",
    "docs:prepare": "node scripts/generate-site.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev . --host 127.0.0.1",
    "docs:build": "npm run docs:prepare && vitepress build .",
    "docs:preview": "vitepress preview . --host 127.0.0.1"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
